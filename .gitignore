# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode + build artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
build/
dist/
.eggs/

# Test + coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# IDE + editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment secrets — never commit
.env
.env.local
.env.*.local

# Private scrub-term list for the repo no-personal-content test
tests/scrub_terms.local.txt

# Local archive folders (consolidator + tests create these at runtime)...
_archive/
seed-vault/_archive/
# ...but the committed lane-vault quarantine fixtures under _archive/ MUST
# stay tracked — without them the bridge-quarantine tests would run against
# a vault with no archive rollups and pass vacuously on every fresh clone.
!tests/fixtures/lane-vault/_archive/

# Local user state (logs, scratch)
*.log
scratch/
